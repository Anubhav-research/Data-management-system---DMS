# Money Honey DMS split demo - configuration.
# Copy to .env to override. Values here are DEMO placeholders, not real credentials.

# Websites (Vite dev servers). 5173 = DMS v1 and 5174 = single-system DMS 2 demo stay free.
PDMS_PORT=5175
IDMS_PORT=5176

# Back-end services
P_API_PORT=4101
I_API_PORT=4102
TP_SIM_PORT=4103
BRIDGE_PORT=4104
# Content Hub: Document Repository + Circulars, shared by every DMS website (company content, no client data)
CONTENT_PORT=4105
# Market automation key: POST /content/market/feed publishes a Market Update straight away (npm run market:feed -- <xlsx>)
MARKET_FEED_KEY=market-feed-demo-key

# Service keys (each website's Vite proxy adds its own key; the browser never sees it)
P_API_KEY=pdms-demo-key
I_API_KEY=idms-demo-key
# Used only by the bridge for the Yes/No number check against i-api and tp-sim
BRIDGE_LOOKUP_KEY=bridge-lookup-demo-key

# Bind address. 0.0.0.0 = reachable from the office LAN (Windows Firewall asks once per port).
HOST=0.0.0.0

# Initial state of the five cross-system flows (Admin can switch them on the Data Boundary page)
FLOW_F1=on
FLOW_F1_ACK=on
FLOW_F2=on
FLOW_F3=on
FLOW_F4=on

# DECISION-13 (default, confirm): what happens to an investor's personal data inside Prospect DMS
# after Investor DMS accepts the handover: remove | hide
INVESTOR_DATA_IN_PDMS=remove
