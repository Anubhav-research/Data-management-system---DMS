# ---------------------------------------------------------------------------
# Data Management System (DMS) - ignore rules
# Stack: Node.js (npm workspaces) · Vue 3 + Vite websites · Node services with JSON data files
# ---------------------------------------------------------------------------

# Dependencies (recreated by `npm install`)
node_modules/

# Build output (recreated by `npm run build:all`)
dist/
dist-ssr/
*.local

# Runtime data: every database is recreated from its seed on first start (or `npm run reset:all`)
services/*/data/
.run/

# Local environment and secrets (copy .env.example to .env; never commit real keys)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# QA output and temporary QA scripts
qa/shots/
qa/_*.mjs
qa/results-*.json
qa/REPORT.md
test-results/
playwright-report/

# Internal project documents (kept outside the public repository)
docs/
PROMPT.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local settings
.claude/

# Operating system and Office temporary files
.DS_Store
Thumbs.db
desktop.ini
~$*
.~lock.*
